<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- ============================================================ -->
        <!-- SECURITY GROUP: PO Approver                                  -->
        <!-- ============================================================ -->
        <record id="group_purchase_approver" model="res.groups">
            <field name="name">PO Approver</field>
            <field name="sequence">15</field>
            <field name="privilege_id" ref="purchase.res_groups_privilege_purchase"/>
            <field name="implied_ids" eval="[(4, ref('purchase.group_purchase_user'))]"/>
            <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
            <field name="comment">Users with this role can approve or reject Purchase Orders awaiting approval.</field>
        </record>

        <!-- Ensure Purchase Managers also inherit PO Approver rights -->
        <record id="purchase.group_purchase_manager" model="res.groups">
            <field name="implied_ids" eval="[(4, ref('group_purchase_approver'))]"/>
        </record>

    </data>
</odoo>
