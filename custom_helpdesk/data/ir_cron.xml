<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        
        <record id="ir_cron_close_resolved_tickets" model="ir.cron">
            <field name="name">Helpdesk: Close resolved tickets after 7 days</field>
            <field name="model_id" ref="helpdesk.model_helpdesk_ticket"/>
            <field name="state">code</field>
            <field name="code">model._cron_close_resolved_tickets()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="active" eval="True"/>
        </record>

        <record id="ir_cron_voip_auto_cleanup" model="ir.cron">
            <field name="name">VOIP: Automatic duplicate cleanup</field>
            <field name="model_id" ref="voip.model_voip_call"/>
            <field name="state">code</field>
            <field name="code">model.auto_cleanup_duplicates()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">5</field>
            <field name="interval_type">minutes</field>
            <field name="numbercall">-1</field>
            <field name="active" eval="True"/>
        </record>

    </data>
</odoo>