        <!-- ===== RECORD-LEVEL RULES ===== -->

        <!-- Performance Goal - Employee sees only their own goals -->
        <record id="rule_performance_goal_employee" model="ir.rule">
            <field name="name">Performance Goal - Employee Own Goals</field>
            <field name="model_id" search="[('model', '=', 'hr.performance.goal')]"/>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="perm_read">True</field>
            <field name="perm_write">True</field>
            <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
        </record>

        <!-- Manager sees goals of direct reports -->
        <record id="rule_performance_goal_manager" model="ir.rule">
            <field name="name">Performance Goal - Manager Team Goals</field>
            <field name="model_id" search="[('model', '=', 'hr.performance.goal')]"/>
            <field name="groups" eval="[(4, ref('hr.group_hr_manager'))]"/>
            <field name="perm_read">True</field>
            <field name="perm_write">True</field>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>

        <!-- Goal Progress - Employee updates own -->
        <record id="rule_goal_progress_employee" model="ir.rule">
            <field name="name">Goal Progress - Employee Own Progress</field>
