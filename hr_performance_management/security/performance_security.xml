<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Line Manager / Supervisor Group (sees only supervised employees) -->
    <record id="group_hr_line_manager" model="res.groups">
        <field name="name">Line Manager: Supervised Employees Only</field>
        <field name="sequence">5</field>
        <field name="privilege_id" ref="hr.res_groups_privilege_employees"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Managers can view employees under their supervision and manage their performance.</field>
    </record>

    <data noupdate="0">

        <!-- ============================================================ -->
        <!-- HR Employee & Directory Visibility Rules                     -->
        <!-- ============================================================ -->

        <!-- 1. hr.employee: Line Managers see only supervised employees + self -->
        <record id="rule_hr_employee_line_manager" model="ir.rule">
            <field name="name">HR Employee - Line Manager (Supervised Only)</field>
            <field name="model_id" ref="hr.model_hr_employee"/>
            <field name="domain_force">['|', ('id', 'child_of', user.employee_ids.ids), ('user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('hr_performance_management.group_hr_line_manager'))]"/>
            <field name="perm_read">1</field>
            <field name="perm_write">0</field>
            <field name="perm_create">0</field>
            <field name="perm_unlink">0</field>
        </record>

        <!-- Ensure HR Officers still see all hr.employee records -->
        <record id="rule_hr_employee_hr_user_all" model="ir.rule">
            <field name="name">HR Employee - HR Officer (All)</field>
            <field name="model_id" ref="hr.model_hr_employee"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('hr.group_hr_user'))]"/>
            <field name="perm_read">1</field>
            <field name="perm_write">1</field>
            <field name="perm_create">1</field>
            <field name="perm_unlink">1</field>
        </record>

        <!-- 2. hr.employee.public: Normal staff (base.group_user) see only own record -->
        <record id="rule_hr_employee_public_own" model="ir.rule">
            <field name="name">HR Employee Public - Own Record Only</field>
            <field name="model_id" ref="hr.model_hr_employee_public"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="perm_read">1</field>
            <field name="perm_write">0</field>
            <field name="perm_create">0</field>
            <field name="perm_unlink">0</field>
        </record>

