<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        
        <!-- Record rules for Performance Cycle -->
        <!-- HR can see all cycles, managers see only their company -->
        <record id="rule_performance_cycle_hr_all" model="ir.rule">
            <field name="name">Performance Cycle - HR Full Access</field>
            <field name="model_id" ref="model_hr_performance_cycle"/>
            <field name="groups" eval="[(4, ref('hr.group_hr_manager'))]"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="1"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>

        <!-- Performance Goal - Employee sees only their own goals -->
        <record id="rule_performance_goal_employee" model="ir.rule">
            <field name="name">Performance Goal - Employee Own Goals</field>
            <field name="model_id" ref="model_hr_performance_goal"/>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
        </record>

        <!-- Manager sees goals of direct reports -->
        <record id="rule_performance_goal_manager" model="ir.rule">
            <field name="name">Performance Goal - Manager Team Goals</field>
            <field name="model_id" ref="model_hr_performance_goal"/>
            <field name="groups" eval="[(4, ref('hr.group_hr_manager'))]"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>

        <!-- Goal Progress - Employee updates own -->
        <record id="rule_goal_progress_employee" model="ir.rule">
            <field name="name">Goal Progress - Employee Own Progress</field>
            <field name="model_id" ref="model_hr_goal_progress_update"/>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
        </record>

        <!-- Final Scorecard - Employee sees own, Manager sees team -->
        <record id="rule_final_scorecard_employee" model="ir.rule">
            <field name="name">Final Scorecard - Employee Own Score</field>
            <field name="model_id" ref="model_hr_final_scorecard"/>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="perm_read" eval="1"/>
            <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
        </record>

        <!-- Appeal Record - Employee sees own appeals -->
        <record id="rule_appeal_record_employee" model="ir.rule">
            <field name="name">Appeal Record - Employee Own Appeals</field>
            <field name="model_id" ref="model_hr_appeal_record"/>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="perm_read" eval="1"/>
            <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
        </record>

    </data>
</odoo>
