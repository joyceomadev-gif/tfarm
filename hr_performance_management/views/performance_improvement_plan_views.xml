<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        
        <!-- Performance Improvement Plan Form -->
        <record id="view_performance_improvement_plan_form" model="ir.ui.view">
            <field name="name">performance.improvement.plan.form</field>
            <field name="model">hr.performance.improvement.plan</field>
            <field name="arch" type="xml">
                <form string="Performance Improvement Plan (PIP)">
                    <header>
                        <button name="action_activate_pip" string="Activate PIP" type="object" invisible="status != 'active'" class="oe_highlight" groups="hr.group_hr_manager"/>
                        <button name="action_complete_pip" string="Complete PIP" type="object" invisible="status != 'active'" class="oe_highlight" groups="hr.group_hr_manager"/>
                        <button name="action_convert_to_disciplinary" string="Convert to Disciplinary" type="object" invisible="status != 'active'" groups="hr.group_hr_manager"/>
                        <button name="action_terminate_pip" string="Terminate (Employee)" type="object" invisible="status != 'active'" groups="hr.group_hr_manager"/>
                        <field name="status" widget="statusbar" statusbar_visible="active,completed,converted,terminated"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <h2><field name="employee_id"/> - Performance Improvement Plan</h2>
                        </div>

                        <div class="alert alert-warning" role="alert">
                            <strong>Auto-Generated PIP:</strong> Score below 60% triggers automatic PIP creation.
                            This plan provides structured support and clear expectations for improvement.
                        </div>

                        <group>
                            <group>
                                <field name="scorecard_id" required="1" readonly="1"/>
                                <field name="cycle_id" readonly="1"/>
                                <field name="employee_id" required="1" readonly="1"/>
                                <field name="manager_id" required="1"/>
                            </group>
                            <group>
                                <field name="hr_specialist_id"/>
                                <field name="start_date" required="1"/>
                                <field name="duration_weeks" required="1"/>
                                <field name="end_date" readonly="1"/>
                            </group>
                        </group>

                        <separator string="PIP Objectives"/>
                        <group>
                            <field name="improvement_areas" required="1" nolabel="1" placeholder="Specific areas for improvement..."/>
                        </group>

                        <group>
                            <field name="objectives" required="1" nolabel="1" placeholder="Specific, measurable objectives..."/>
                        </group>

                        <group>
                            <field name="success_criteria" required="1" nolabel="1" placeholder="Clear metrics to measure success..."/>
                        </group>

                        <separator string="Support Provided"/>
                        <group>
                            <group>
                                <field name="support_provided" nolabel="1" placeholder="Training, mentoring, tools provided..."/>
                            </group>
                            <group>
                                <field name="training_required" nolabel="1" placeholder="Required training courses..."/>
                            </group>
                        </group>

                        <separator string="Monitoring &amp; Progress"/>
                        <group>
                            <group>
                                <field name="review_frequency" required="1"/>
                            </group>
                            <group/>
                        </group>

                        <group>
                            <field name="progress_tracking" nolabel="1" placeholder="Periodic progress notes..."/>
                        </group>

                        <separator string="Outcome"/>
                        <group>
                            <group>
                                <field name="outcome"/>
                                <field name="follow_up_action"/>
                            </group>
                            <group>
                                <field name="outcome_notes" nolabel="1" placeholder="Summary and recommendations..."/>
                            </group>
                        </group>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids" widget="mail_followers"/>
                        <field name="activity_ids" widget="mail_activity"/>
                        <field name="message_ids" widget="mail_thread"/>
                    </div>
                </form>
            </field>
        </record>

        <!-- Performance Improvement Plan List -->
        <record id="view_performance_improvement_plan_tree" model="ir.ui.view">
            <field name="name">performance.improvement.plan.list</field>
            <field name="model">hr.performance.improvement.plan</field>
            <field name="arch" type="xml">
                <list string="Performance Improvement Plans" decoration-danger="status=='terminated'" decoration-warning="outcome=='not_met'" decoration-success="outcome=='met' or outcome=='exceeded'">
                    <field name="employee_id"/>
                    <field name="start_date"/>
                    <field name="end_date"/>
                    <field name="review_frequency"/>
                    <field name="outcome"/>
                    <field name="follow_up_action"/>
                    <field name="status" widget="badge"/>
                </list>
            </field>
        </record>

        <!-- Performance Improvement Plan Search -->
        <record id="view_performance_improvement_plan_search" model="ir.ui.view">
            <field name="name">performance.improvement.plan.search</field>
            <field name="model">hr.performance.improvement.plan</field>
            <field name="arch" type="xml">
                <search string="Performance Improvement Plans">
                    <field name="employee_id"/>
                    <field name="manager_id"/>
                    <field name="hr_specialist_id"/>
                    <separator/>
                    <filter name="filter_active" string="Active" domain="[('status', '=', 'active')]"/>
                    <filter name="filter_completed" string="Completed" domain="[('status', '=', 'completed')]"/>
                    <filter name="filter_not_met" string="Outcome: Not Met" domain="[('outcome', '=', 'not_met')]"/>
                    <filter name="filter_met" string="Outcome: Met/Exceeded" domain="[('outcome', 'in', ['met', 'exceeded'])]"/>
                </search>
            </field>
        </record>

        <!-- Performance Improvement Plan Action -->
        <record id="action_performance_improvement_plan" model="ir.actions.act_window">
            <field name="name">Performance Improvement Plans</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">hr.performance.improvement.plan</field>
            <field name="view_mode">tree,form</field>
            <field name="search_view_id" ref="view_performance_improvement_plan_search"/>
        </record>

    </data>
</odoo>