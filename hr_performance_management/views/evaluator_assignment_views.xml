<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        
        <!-- Evaluator Assignment Form -->
        <record id="view_evaluator_assignment_form" model="ir.ui.view">
            <field name="name">evaluator.assignment.form</field>
            <field name="model">hr.evaluator.assignment</field>
            <field name="arch" type="xml">
                <form string="Evaluator Assignment">
                    <header>
                        <button name="action_submit_assignment" string="Submit" type="object" states="draft" class="oe_highlight"/>
                        <button name="action_approve_assignment" string="Approve" type="object" states="submitted" class="oe_highlight" groups="hr.group_hr_manager"/>
                        <field name="status" widget="statusbar" statusbar_visible="draft,submitted,approved"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <h2><field name="employee_id"/> - <field name="cycle_id"/></h2>
                        </div>

                        <group>
                            <group>
                                <field name="cycle_id" required="1"/>
                                <field name="employee_id" required="1"/>
                                <field name="department_id" readonly="1"/>
                                <field name="job_title_id" readonly="1"/>
                            </group>
                        </group>

                        <group string="Technical Evaluators">
                            <field name="line_manager_id" required="1"/>
                            <field name="hod_id"/>
                        </group>

                        <group string="Behavioral Evaluators (Peers)">
                            <field name="peer_1_id"/>
                            <field name="peer_2_id"/>
                            <field name="peer_3_id"/>
                        </group>

                        <group string="Subordinate Evaluators">
                            <field name="subordinate_1_id"/>
                            <field name="subordinate_2_id"/>
                        </group>

                        <group string="Additional Evaluators">
                            <field name="internal_customer_id"/>
                            <field name="external_customer_id"/>
                        </group>

                        <group>
                            <field name="notes" nolabel="1" placeholder="Additional notes..."/>
                        </group>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids" widget="mail_followers"/>
                        <field name="activity_ids" widget="mail_activity"/>
                        <field name="message_ids" widget="mail_thread"/>
                    </div>
                </form>
            </field>
        </record>

        <!-- Evaluator Assignment Tree -->
        <record id="view_evaluator_assignment_tree" model="ir.ui.view">
            <field name="name">evaluator.assignment.tree</field>
            <field name="model">hr.evaluator.assignment</field>
            <field name="arch" type="xml">
                <tree string="Evaluator Assignments">
                    <field name="cycle_id"/>
                    <field name="employee_id"/>
                    <field name="department_id"/>
                    <field name="line_manager_id"/>
                    <field name="hod_id"/>
                    <field name="status" widget="badge"/>
                </tree>
            </field>
        </record>

        <!-- Evaluator Assignment Search -->
        <record id="view_evaluator_assignment_search" model="ir.ui.view">
            <field name="name">evaluator.assignment.search</field>
            <field name="model">hr.evaluator.assignment</field>
            <field name="arch" type="xml">
                <search string="Evaluator Assignments">
                    <field name="cycle_id"/>
                    <field name="employee_id"/>
                    <field name="department_id"/>
                    <field name="line_manager_id"/>
                    <separator/>
                    <filter name="filter_draft" string="Draft" domain="[('status', '=', 'draft')]"/>
                    <filter name="filter_submitted" string="Submitted" domain="[('status', '=', 'submitted')]"/>
                    <filter name="filter_approved" string="Approved" domain="[('status', '=', 'approved')]"/>
                </search>
            </field>
        </record>

        <!-- Evaluator Assignment Action -->
        <record id="action_evaluator_assignment" model="ir.actions.act_window">
            <field name="name">Evaluator Assignments</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">hr.evaluator.assignment</field>
            <field name="view_mode">tree,form</field>
            <field name="search_view_id" ref="view_evaluator_assignment_search"/>
        </record>

    </data>
</odoo>
