<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        
        <!-- Coaching Session Form -->
        <record id="view_coaching_session_form" model="ir.ui.view">
            <field name="name">coaching.session.form</field>
            <field name="model">hr.coaching.session</field>
            <field name="arch" type="xml">
                <form string="Coaching &amp; Review Meeting">
                    <header>
                        <button name="action_mark_completed" string="Mark Completed" type="object" invisible="status != 'scheduled'" class="oe_highlight"/>
                        <button name="action_cancel_session" string="Cancel Session" type="object" invisible="status != 'scheduled'"/>
                        <button name="action_schedule_follow_up" string="Schedule Follow-up" type="object" invisible="status != 'completed'"/>
                        <field name="status" widget="statusbar" statusbar_visible="scheduled,completed,cancelled"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <h2><field name="employee_id"/> - Coaching Session</h2>
                        </div>

                        <group>
                            <group>
                                <field name="cycle_id" required="1"/>
                                <field name="employee_id" required="1"/>
                                <field name="supervisor_id" required="1"/>
                            </group>
                            <group>
                                <field name="meeting_date" required="1"/>
                                <field name="meeting_duration" widget="float_time"/>
                                <field name="follow_up_date"/>
                            </group>
                        </group>

                        <group string="Session Content">
                            <field name="objectives_discussed" required="1" nolabel="1" placeholder="What was discussed..."/>
                        </group>

                        <group>
                            <group>
                                <field name="employee_feedback" nolabel="1" placeholder="Employee feedback..."/>
                            </group>
                            <group>
                                <field name="supervisor_feedback" nolabel="1" placeholder="Supervisor feedback..."/>
                            </group>
                        </group>

                        <group>
                            <field name="action_items" nolabel="1" placeholder="Agreed-upon action items..."/>
                        </group>

                        <group>
                            <field name="session_notes" nolabel="1" placeholder="Additional notes..."/>
                        </group>

                        <group string="Attachments">
                            <field name="attachment_ids" nolabel="1" widget="many2many_tags"/>
                        </group>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids" widget="mail_followers"/>
                        <field name="activity_ids" widget="mail_activity"/>
                        <field name="message_ids" widget="mail_thread"/>
                    </div>
                </form>
            </field>
        </record>

        <!-- Coaching Session List -->
        <record id="view_coaching_session_tree" model="ir.ui.view">
            <field name="name">coaching.session.list</field>
            <field name="model">hr.coaching.session</field>
            <field name="arch" type="xml">
                <list string="Coaching Sessions">
                    <field name="meeting_date"/>
                    <field name="employee_id"/>
                    <field name="supervisor_id"/>
                    <field name="objectives_discussed"/>
                    <field name="follow_up_date"/>
                    <field name="status" widget="badge"/>
                </list>
            </field>
        </record>

        <!-- Coaching Session Action -->
        <record id="action_coaching_session" model="ir.actions.act_window">
            <field name="name">Coaching Sessions</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">hr.coaching.session</field>
            <field name="view_mode">list,form</field>
        </record>

    </data>
</odoo>