<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        
        <!-- Appeal Record Form -->
        <record id="view_appeal_record_form" model="ir.ui.view">
            <field name="name">appeal.record.form</field>
            <field name="model">hr.appeal.record</field>
            <field name="arch" type="xml">
                <form string="Appeal Record">
                    <header>
                        <button name="action_submit_to_hr" string="Submit to HR" type="object" states="submitted" class="oe_highlight"/>
                        <button name="action_mark_resolved" string="Resolve Appeal" type="object" states="under_review" class="oe_highlight" groups="hr.group_hr_manager"/>
                        <button name="action_escalate" string="Escalate Appeal" type="object" states="under_review" groups="hr.group_hr_manager"/>
                        <button name="action_view_scorecard" string="View Scorecard" type="object"/>
                        <field name="appeal_status" widget="statusbar" statusbar_visible="submitted,under_review,resolved,escalated"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <h2><field name="employee_id"/> Appeal - <field name="cycle_id"/></h2>
                        </div>

                        <group>
                            <group>
                                <field name="scorecard_id" required="1" readonly="1"/>
                                <field name="employee_id" required="1" readonly="1"/>
                                <field name="appeal_date" readonly="1"/>
                            </group>
                            <group>
                                <field name="cycle_id" readonly="1"/>
                                <field name="hr_reviewer_id"/>
                                <field name="review_date"/>
                            </group>
                        </group>

                        <group string="Appeal Details">
                            <field name="appeal_reason" required="1" nolabel="1" placeholder="Reason for appealing the appraisal..."/>
                        </group>

                        <group string="Supporting Evidence">
                            <field name="supporting_evidence" nolabel="1" placeholder="Evidence or documentation..."/>
                        </group>

                        <group string="Attachments">
                            <field name="evidence_attachment_ids" nolabel="1" widget="many2many_tags"/>
                        </group>

                        <group string="HR Review">
                            <field name="review_notes" nolabel="1" placeholder="HR review and findings..."/>
                        </group>

                        <group string="Resolution">
                            <group>
                                <field name="resolution"/>
                                <field name="adjusted_final_score" attrs="{'required': [('resolution', '!=', False)]}"/>
                            </group>
                            <group>
                                <field name="resolution_notes" nolabel="1" placeholder="Resolution notes..."/>
                            </group>
                        </group>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids" widget="mail_followers"/>
                        <field name="activity_ids" widget="mail_activity"/>
                        <field name="message_ids" widget="mail_thread"/>
                    </div>
                </form>
            </field>
        </record>

        <!-- Appeal Record Tree -->
        <record id="view_appeal_record_tree" model="ir.ui.view">
            <field name="name">appeal.record.tree</field>
            <field name="model">hr.appeal.record</field>
            <field name="arch" type="xml">
                <tree string="Appeal Records">
                    <field name="employee_id"/>
                    <field name="cycle_id"/>
                    <field name="appeal_date"/>
                    <field name="appeal_reason"/>
                    <field name="resolution"/>
                    <field name="appeal_status" widget="badge"/>
                </tree>
            </field>
        </record>

        <!-- Appeal Record Search -->
        <record id="view_appeal_record_search" model="ir.ui.view">
            <field name="name">appeal.record.search</field>
            <field name="model">hr.appeal.record</field>
            <field name="arch" type="xml">
                <search string="Appeal Records">
                    <field name="employee_id"/>
                    <field name="cycle_id"/>
                    <field name="appeal_status"/>
                    <separator/>
                    <filter name="filter_submitted" string="Submitted" domain="[('appeal_status', '=', 'submitted')]"/>
                    <filter name="filter_under_review" string="Under Review" domain="[('appeal_status', '=', 'under_review')]"/>
                    <filter name="filter_resolved" string="Resolved" domain="[('appeal_status', '=', 'resolved')]"/>
                    <filter name="filter_escalated" string="Escalated" domain="[('appeal_status', '=', 'escalated')]"/>
                </search>
            </field>
        </record>

        <!-- Appeal Record Action -->
        <record id="action_appeal_record" model="ir.actions.act_window">
            <field name="name">Appeal Records</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">hr.appeal.record</field>
            <field name="view_mode">tree,form</field>
            <field name="search_view_id" ref="view_appeal_record_search"/>
        </record>

    </data>
</odoo>
