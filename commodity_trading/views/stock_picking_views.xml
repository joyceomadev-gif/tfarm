<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_picking_form_inherit_commodity_weighbridge" model="ir.ui.view">
        <field name="name">stock.picking.form.inherit.commodity.weighbridge</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">

            <xpath expr="//header" position="inside">
                <button name="action_calculate_qc" type="object" string="Evaluate QC Results" class="btn-primary"
                        invisible="picking_type_code != 'incoming' or qc_status != 'pending'"/>
                
                <button name="action_finalize_qc" type="object" string="Finalize QC Penalty" class="btn-warning"
                        invisible="picking_type_code != 'incoming' or qc_status != 'fail' or is_qc_locked == True"/>
            </xpath>

            <xpath expr="//field[@name='origin']" position="after">
                <field name="commodity_contract_id" />
            </xpath>

            <xpath expr="//notebook" position="inside">
                
                <page string="Weighbridge" name="weighbridge_discounts" invisible="picking_type_code != 'incoming'">
                    <group>
                        <group string="Weighbridge Readings">
                            <field name="weighbridge_in"/>
                            <field name="weighbridge_out"/>
                            <field name="gross_weight" decoration-bf="1"/>
                        </group>
                        <group string="Physical Deductions (Inventory)">
                            <field name="bag_count"/>
                            <field name="bag_discount"/>
                            <field name="moisture_discount" widget="percentage"/>
                            <field name="net_weight" decoration-bf="1" decoration-success="net_weight &gt; 0"/>
                        </group>
                    </group>
                </page>
                <field name="picking_type_code" invisible="1"/>
                <page string="Quality Control (QC)" name="quality_control" invisible="picking_type_code != 'incoming'">
                    <field name="is_qc_locked" invisible="1"/>
                    
                    <group>
                        <group>
                            <field name="qc_status" widget="badge" 
                                   decoration-success="qc_status == 'pass'" 
                                   decoration-danger="qc_status == 'fail'" 
                                   decoration-warning="qc_status == 'pending'"/>
                        </group>
                        <group>
                            <field name="quality_discount_weight" widget="percentage"
                                   invisible="qc_status != 'fail'" 
                                   readonly="is_qc_locked == True"/>
                            <field name="payable_weight" readonly="1"/>
                        </group>
                    </group>

                    <group string="Laboratory Test Results">
                        <group string="ADM Group">
                            <field name="qc_sieve" readonly="is_qc_locked == True"/>
                            <field name="qc_fm" readonly="is_qc_locked == True"/>
                            <field name="qc_flat" readonly="is_qc_locked == True"/>
                            <field name="qc_adm_sum" decoration-danger="qc_adm_sum &gt; 3.5"/>
                        </group>
                        
                        <group string="CRM Group">
                            <field name="qc_bb" readonly="is_qc_locked == True"/>
                            <field name="qc_fragment" readonly="is_qc_locked == True"/>
                            <field name="qc_cluster" readonly="is_qc_locked == True"/>
                            <field name="qc_crm_sum" decoration-danger="qc_crm_sum &gt; 3.5"/>
                        </group>

                        <group string="TD Group">
                            <field name="qc_mould" readonly="is_qc_locked == True"/>
                            <field name="qc_insect" readonly="is_qc_locked == True"/>
                            <field name="qc_td_sum" decoration-danger="qc_td_sum &gt; 5.0"/>
                        </group>

                        <group string="Bean Bloc">
                            <field name="qc_slaty" readonly="is_qc_locked == True"/>
                            <field name="qc_moisture" readonly="is_qc_locked == True"/>
                            <field name="qc_bean_count" readonly="is_qc_locked == True"/>
                        </group>
                    </group>
                </page>

            </xpath>
            
        </field>
    </record>
</odoo>