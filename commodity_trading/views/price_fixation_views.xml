<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_price_fixation_form" model="ir.ui.view">
        <field name="name">price.fixation.form</field>
        <field name="model">price.fixation</field>
        <field name="arch" type="xml">
            <form string="Price Fixation">
                <header>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <header>
                        <button name="action_convert_to_final" type="object" string="Convert to Final" class="btn-primary"
                                invisible="fixation_type != 'provisional'"/>
                    </header>
                    <group>
                        <group>
                            <field name="contract_id"/>
                            <field name="fixation_type"/>
                            <field name="date"/>
                        </group>
                        <group>
                            <field name="fixed_qty"/>
                            <field name="provisional_percentage"/>
                            <field name="market_price_at_fixation"/>
                            <field name="differential"/>
                            <field name="final_fixed_price"/>
                            <field name="linked_provisional_id"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_price_fixation_convert_wizard_form" model="ir.ui.view">
        <field name="name">price.fixation.convert.wizard.form</field>
        <field name="model">price.fixation.convert.wizard</field>
        <field name="arch" type="xml">
            <form string="Convert Provisional to Final">
                <sheet>
                    <group>
                        <field name="provisional_id" readonly="1"/>
                        <field name="qty"/>
                    </group>
                    <footer>
                        <button string="Convert" type="object" name="action_confirm" class="btn-primary"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_commodity_contract_form_inherit_fixation" model="ir.ui.view">
        <field name="name">commodity.contract.form.inherit.fixation</field>
        <field name="model">commodity.contract</field>
        <field name="inherit_id" ref="commodity_trading.view_commodity_contract_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/group" position="after">
                <notebook>
                    <page string="Price Fixations">
                        <field name="fixation_ids">
                            <list editable="bottom">
                                <field name="date"/>
                                <field name="fixation_type"/>
                                <field name="fixed_qty"/>
                                
                                <field name="provisional_percentage" invisible="fixation_type != 'provisional'"/>
                                <field name="linked_provisional_id" invisible="fixation_type == 'provisional'" optional="show"/>
                                
                                <field name="market_price_at_fixation"/>
                                <field name="final_fixed_price" readonly="1"/>
                                <field name="state"/>
                            </list>
                        </field>
                    </page>
                </notebook>
            </xpath>
        </field>
    </record>
</odoo>