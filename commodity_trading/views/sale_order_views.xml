<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_inherit_commodity" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.commodity</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            
            <xpath expr="//header" position="inside">
                <button name="action_create_commodity_invoice" 
                        type="object" 
                        string="Create Commodity Invoice" 
                        class="btn-primary" 
                        invisible="not commodity_contract_id or state != 'sale'"/>
                        
                <button name="action_print_consolidated_invoice" 
                        type="object" 
                        string="Print Consolidated PDF" 
                        class="btn-secondary" 
                        invisible="not commodity_contract_id"/>
            </xpath>

            <xpath expr="//button[@id='create_invoice']" position="attributes">
                <attribute name="invisible">commodity_contract_id != False</attribute>
            </xpath>
            <xpath expr="//button[@id='create_invoice_percentage']" position="attributes">
                <attribute name="invisible">commodity_contract_id != False</attribute>
            </xpath>

            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="commodity_contract_id"/>
                <field name="exchange_rate_to_company" invisible="1"/>
            </xpath>

            <xpath expr="//sheet" position="inside">
                <group string="Exchange Rate Information" invisible="not currency_id">
                    <field name="exchange_rate_to_company" readonly="1" nolabel="1" string="Current Exchange Rate"/>
                </group>
            </xpath>

            <xpath expr="//page[last()]" position="after">
                <page string="Exchange Rates" invisible="not currency_id">
                    <field name="related_currency_rate_ids" readonly="1" nolabel="1" mode="tree"/>
                </page>
            </xpath>
            
        </field>
    </record>
</odoo>