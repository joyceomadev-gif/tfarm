<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_consolidated_invoice" model="ir.actions.report">
        <field name="name">Consolidated ETG Invoice</field>
        <field name="model">sale.order</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">commodity_trading.report_consolidated_invoice_template</field>
        <field name="report_file">commodity_trading.report_consolidated_invoice_template</field>
        <field name="print_report_name">'Consolidated_Invoice_%s' % (object.name)</field>
        <field name="binding_model_id" ref="sale.model_sale_order"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_consolidated_invoice_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.basic_layout">
                    <div class="page" style="font-family: Arial, sans-serif; font-size: 14px; color: #000; position: relative; padding-top: 20px;">
                        
                        <div style="position: absolute; top: -20px; right: -20px; width: 0; height: 0; border-top: 130px solid #2ea133; border-left: 130px solid transparent; z-index: 10;"></div>
                        
                        <div class="row pt-4">
                            <div class="col-7">
                                
                                <div style="margin-bottom: 25px;">
                                    <img t-if="o.company_id.logo" t-att-src="image_data_uri(o.company_id.logo)" style="max-height: 85px; width: auto;" alt="Company Logo"/>
                                    <h1 t-else="" style="font-weight: bold; color: #1a1a1a; margin-bottom: 0;">
                                        <span t-field="o.company_id.name"/>
                                    </h1>
                                </div>
                                
                                <div>
                                    <strong>TO,</strong><br/>
                                    <span style="font-weight: bold; font-size: 16px;" t-field="o.partner_id.name"/><br/>
                                    <strong>Address:</strong> <span t-field="o.partner_id.street"/>, <span t-field="o.partner_id.city"/><br/>
                                    <span t-field="o.partner_id.country_id.name"/><br/>
                                    <br/>
                                    <strong>Invoice Number:</strong> <span t-field="o.name"/>
                                </div>
                            </div>
                            
                            <div class="col-5 text-end">
                                <h2 style="font-weight: bold; text-decoration: underline; margin-bottom: 15px; position: relative; z-index: 20;">INVOICE</h2>
                                <div style="position: relative; z-index: 20;">
                                    <strong>DATE:</strong> <span t-esc="datetime.datetime.now().strftime('%dTH %B %Y').upper()"/>
                                </div>
                            </div>
                        </div>

                        <div class="row mt-5">
                            <div class="col-12">
                                <table style="width: 100%; border: none;">
                                    <tr>
                                        <td style="width: 18%;"><strong>COMMODITY:</strong></td>
                                        <td><span t-field="o.commodity_contract_id.product_id.name"/></td>
                                    </tr>
                                    <tr>
                                        <td><strong>TONNAGE:</strong></td>
                                        <td><span t-field="o.commodity_contract_id.contract_qty"/> MT (<span t-field="o.commodity_contract_id.total_fixed_qty"/> MT Delivered)</td>
                                    </tr>
                                    <tr>
                                        <td><strong>CONTRACT NO:</strong></td>
                                        <td><span t-field="o.commodity_contract_id.name"/></td>
                                    </tr>
                                </table>
                                
                                <div class="mt-3">
                                    <strong>FIXATION VALUES:</strong><br/>
                                    <t t-foreach="o.commodity_contract_id.fixation_ids" t-as="fix">
                                        <div style="margin-left: 15px; margin-bottom: 3px;">
                                            <span t-field="fix.name"/> @ <span t-field="fix.market_price_at_fixation"/> 
                                            DIFFERENTIAL: <span t-field="fix.differential"/> FOR <span t-field="fix.fixed_qty"/> MT
                                        </div>
                                    </t>
                                    <div style="margin-left: 15px; font-style: italic; margin-top: 5px;">
                                        (Fobbing Charges deducted to arrive at price below)
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="row mt-5">
                            <div class="col-12">
                                <table style="width: 100%; border-collapse: collapse;">
                                    <thead>
                                        <tr style="border-top: 2px solid #000; border-bottom: 2px solid #000;">
                                            <th style="padding: 8px 5px;" class="text-start">CONTRACT No.</th>
                                            <th style="padding: 8px 5px;" class="text-center">QTY(MT)</th>
                                            <th style="padding: 8px 5px;" class="text-start">DESCRIPTION</th>
                                            <th style="padding: 8px 5px;" class="text-end">FINAL PRICE($)</th>
                                            <th style="padding: 8px 5px;" class="text-end">FINAL VALUE($)</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <t t-set="total_qty" t-value="0.0"/>
                                        <t t-set="total_val" t-value="0.0"/>
                                        
                                        <t t-set="posted_invoices" t-value="o.invoice_ids.filtered(lambda inv: inv.state == 'posted' and inv.move_type == 'out_invoice')"/>
                                        
                                        <t t-foreach="posted_invoices.mapped('invoice_line_ids').filtered(lambda l: l.product_id)" t-as="line">
                                            <t t-set="total_qty" t-value="total_qty + line.quantity"/>
                                            <t t-set="total_val" t-value="total_val + line.price_subtotal"/>
                                            
                                            <tr style="border-bottom: 1px solid #e6e6e6;">
                                                <td style="padding: 8px 5px;" class="text-start"><span t-field="o.commodity_contract_id.name"/></td>
                                                <td style="padding: 8px 5px;" class="text-center"><span t-esc="'%.3f' % line.quantity"/></td>
                                                <td style="padding: 8px 5px;" class="text-start"><span t-field="line.name"/></td>
                                                <td style="padding: 8px 5px;" class="text-end"><span t-field="line.price_unit" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/></td>
                                                <td style="padding: 8px 5px;" class="text-end"><span t-field="line.price_subtotal" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/></td>
                                            </tr>
                                        </t>
                                        
                                        <tr style="border-top: 2px solid #000; border-bottom: 2px solid #000;">
                                            <td style="padding: 8px 5px;"><strong>Total</strong></td>
                                            <td style="padding: 8px 5px;" class="text-center"><strong><span t-esc="'%.3f' % total_qty"/></strong></td>
                                            <td style="padding: 8px 5px;"><strong>Average Price</strong></td>
                                            <td style="padding: 8px 5px;" class="text-end"><strong><span t-esc="total_val / total_qty if total_qty > 0 else 0" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/></strong></td>
                                            <td style="padding: 8px 5px;" class="text-end"><strong><span t-esc="total_val" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/></strong></td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>

                        <div class="row mt-4">
                            <div class="col-6"></div>
                            <div class="col-6">
                                <table style="width: 100%;">
                                    <tr>
                                        <td style="padding: 5px 0;"><strong>TOTAL VALUE:</strong></td>
                                        <td class="text-end" style="padding: 5px 0;"><strong><span t-esc="total_val" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/></strong></td>
                                    </tr>
                                    <tr>
                                        <td style="padding: 5px 0;"><strong>95% OF TOTAL VALUE RECEIVABLE:</strong></td>
                                        <td class="text-end" style="padding: 5px 0;"><strong><span t-esc="total_val * 0.95" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/></strong></td>
                                    </tr>
                                </table>
                            </div>
                        </div>

                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>