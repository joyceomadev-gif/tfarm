<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- 1. Document TF/ABT/001: Abattoir Daily Production & Yield Report -->
    <record id="action_report_abattoir_production" model="ir.actions.report">
        <field name="name">Daily Production &amp; Yield Report (TF/ABT/001)</field>
        <field name="model">taghini.abattoir.batch</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">chicken_farm_module.report_abattoir_production</field>
        <field name="report_file">chicken_farm_module.report_abattoir_production</field>
        <field name="print_report_name">'Production_Yield_Report_' + (object.name or '').replace('/', '_')</field>
        <field name="binding_model_id" ref="model_taghini_abattoir_batch"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="paperformat_taghini_portrait"/>
    </record>

