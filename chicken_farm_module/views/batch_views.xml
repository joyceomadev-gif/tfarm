<odoo>
    <record id="view_chicken_batch_form" model="ir.ui.view">
        <field name="name">taghini.chicken.batch.form</field>
        <field name="model">taghini.chicken.batch</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="date"/>
                            <field name="supplier_id"/>
                        </group>
                        <group>
                            <field name="total_quantity"/>
                            <field name="remaining_quantity" decoration-danger="remaining_quantity &lt; 0"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Allocated Pens">
                            <field name="series_ids" readonly="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_chicken_batch" model="ir.actions.act_window">
        <field name="name">Purchased Batches</field>
        <field name="res_model">taghini.chicken.batch</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_taghini_batch" name="Purchased Batches" parent="menu_taghini_root" action="action_chicken_batch" sequence="1"/>
</odoo>