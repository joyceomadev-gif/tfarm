<odoo>
    <record id="view_taghini_log_tree" model="ir.ui.view">
        <field name="name">taghini.log.tree</field>
        <field name="model">taghini.daily.log</field>
        <field name="arch" type="xml">
            <list string="Daily Logs" editable="bottom">
                <field name="date"/>
                <field name="flock_id" readonly="1"/>
                <field name="age_day"/>
                <field name="mortality"/>
                <field name="feed_product_id"/> <field name="feed_consumed_bags"/>
                <field name="feed_consumed_kg"/>
                <field name="remarks"/>
            </list>
        </field>
    </record>
    <record id="action_taghini_daily_log" model="ir.actions.act_window">
        <field name="name">Daily Logs</field>
        <field name="res_model">taghini.daily.log</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem id="menu_taghini_daily_log" name="Daily logs" parent="menu_taghini_root" action="action_taghini_daily_log"/>
</odoo>