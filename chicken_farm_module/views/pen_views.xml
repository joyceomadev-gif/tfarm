<odoo>
    <record id="view_taghini_pen_form" model="ir.ui.view">
        <field name="name">taghini.pen.form</field>
        <field name="model">taghini.pen</field>
        <field name="arch" type="xml">
            <form string="Pen / Housing">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_flocks" type="object" class="oe_stat_button" icon="fa-cubes">
                            <field name="series_count" widget="statinfo" string="Batches"/>
                        </button>
                    </div>

                    <div class="oe_title">
                        <h1><field name="pen_code" readonly="1"/></h1>
                    </div>
                    
                    
                    <group>
                        <group string="Configuration">
                            <field name="name" string="Pen Name" placeholder="e.g. Pen 01"/>
                            <field name="farm_id"/>
                            <field name="location_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group string="Staff Assignment">
                            <field name="manager_id" widget="many2one_avatar_user"/>
                            <field name="vet_id" widget="many2one_avatar_user"/>
                        </group>
                    </group>

                    <group string="Housing &amp; Equipment Specifications">
                        <group>
                            <field name="housing_system"/>
                            <field name="floor_area_m2"/>
                            <field name="capacity" class="fw-bold fs-5"/>
                            <field name="stocking_density"/>
                            <field name="female_feeder_space_cm"/>
                        </group>
                        <group>
                            <field name="male_feeder_count"/>
                            <field name="drinker_count"/>
                            <field name="nest_holes"/>
                        </group>
                    </group>

                    <div class="mt-4">
                        <button name="action_create_batch" type="object" string="Start New Batch in this Pen" class="btn-primary"/>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_taghini_pen_tree" model="ir.ui.view">
        <field name="name">taghini.pen.tree</field>
        <field name="model">taghini.pen</field>
        <field name="arch" type="xml">
            <list string="Pens" export_xlsx="1">
                <field name="pen_code" string="Pen ID" class="fw-bold"/>
                <field name="name"/>
                <field name="capacity"/>
                <field name="floor_area_m2" optional="show"/>
                <field name="location_id"/>
                <field name="manager_id" widget="many2one_avatar_user"/>
                <field name="vet_id" widget="many2one_avatar_user"/>
                <field name="series_count"/>
            </list>
        </field>
    </record>

    <record id="action_taghini_pen" model="ir.actions.act_window">
        <field name="name">Pens &amp; Houses</field>
        <field name="res_model">taghini.pen</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_taghini_pen" name="Pens / Houses" parent="menu_taghini_config" action="action_taghini_pen" sequence="5"/>
</odoo>