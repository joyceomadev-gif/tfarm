<odoo>
    <data noupdate="1">
        <record id="seq_taghini_harvest" model="ir.sequence">
            <field name="name">Harvest Sequence</field>
            <field name="code">taghini.harvest</field>
            <field name="prefix">HRV/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>
        <record id="seq_taghini_abattoir" model="ir.sequence">
            <field name="name">Abattoir Production</field>
            <field name="code">taghini.abattoir</field>
            <field name="prefix">PROD/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>
        <record id="seq_taghini_breeder_batch" model="ir.sequence">
            <field name="name">Breeder Batch</field>
            <field name="code">taghini.breeder.batch</field>
            <field name="prefix">BRD/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>